{
  "name": "nexus-tasks-frontend",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "prepare": "cd .. && npx husky",
    "format": "prettier --write \"**/*.{js,ts,vue,css,scss,md,json}\" --ignore-path .gitignore"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@nuxtjs/color-mode": "^4.0.0",
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "@tiptap/extension-mention": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/vue-3": "^3.27.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.11",
    "isomorphic-dompurify": "^3.18.0",
    "lucide-vue-next": "^0.577.0",
    "markdown-it": "^14.1.1",
    "marked": "^18.0.5",
    "nuxt": "^4.4.2",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tippy.js": "^6.3.7",
    "vue": "^3.5.30",
    "vue-markdown-render": "^2.3.0",
    "vue-router": "^5.0.3",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@nuxt/eslint": "^1.15.2",
    "@types/dompurify": "^3.0.5",
    "@types/marked": "^5.0.2",
    "eslint": "^9.39.4",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  },
  "lint-staged": {
    "**/*.{js,ts,vue}": [
      "eslint",
      "prettier --check"
    ],
    "**/*.{css,scss,md,json}": [
      "prettier --check"
    ]
  }
}
